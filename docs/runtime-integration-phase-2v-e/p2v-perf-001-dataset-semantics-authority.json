        "0": "current",
        "1": "history"
      }
    }
  },
  "generationLoops": {
    "menu_items": {
      "kind": "nested-loops",
      "counters": ["tenantOrdinal", "menuOrdinal", "itemWithinMenu"],
      "orders": ["ascending", "ascending", "ascending"],
      "emits": "one-row-per-innermost-iteration"
