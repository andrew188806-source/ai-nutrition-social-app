  "composition": {
    "precedence": "This clarification is normative only for the A-F dataset-generator operands named in resolvedFields. It replaces omitted, ambiguous, or undefined generator operands for those fields and leaves every base dataset count, relationship, case, threshold, workload, plan metric, authorization, scan, buffer, spill, lifecycle, and evidence obligation unchanged.",
    "conflict": "Any conflict outside resolvedFields, or any generator value not produced by the closed program vocabulary, fails closed.",
    "resolvedFields": [
      "menu_items.name.ordinalIdentifier",
      "menu_items.allergens",
      "menu_item_nutrition.version0.active.source",
      "menu_item_nutrition.version0.active.verified_status",
      "menu_item_nutrition.version0.nonActive.source",
      "menu_item_nutrition.version0.nonActive.verified_status",
      "restaurants.created_at",
      "menu_item_nutrition.updated_at"
    ],
    "preservedBaseInvariants": {
      "tenants": 50,
      "items": 5520,
      "nutritionRows": 11040,
      "currentNutritionRows": 5520,
      "publicViewEligibleNutritionRows": 4256,
      "cases": 35,
