{
  "schema": "tastkind.p2v-perf.plan-metric-semantics",
  "version": 1,
  "clarificationId": "P2V-PERF-001A-D1",
  "baseAuthority": {
    "commit": "b95d92ef58bc956bac1fb32cfb09b77309645b47",
    "path": "docs/runtime-integration-phase-2v-e/p2v-perf-001-representative-scale-authority.json",
    "sha256": "4bfc94a5085a537c3faff97deb8329800f8171e506cbe37c0308a66035a24ade",
    "postgresMajor": 17
  },
  "composition": {
    "precedence": "This clarification is normative only for the five fields in thresholdFields. For those fields it supplies the previously absent executable calculation semantics and takes precedence over an omitted or less-specific calculation in the base authority. The base authority remains normative for every value, case, profile, track, scan, buffer, payload, authorization, spill and lifecycle rule and is never rewritten by this clarification.",
    "conflict": "A conflict outside the five calculation semantics fails closed; neither document may be silently weakened.",
    "thresholdFields": [
      "maxEstimateRatio",
      "maxFanout",
      "maxNestedLoopRows",
      "maxSortMemoryKb",
      "maxHashMemoryKb"
    ]
  },
  "evaluator": {
    "language": "P2V_PLAN_METRIC_DSL_1",
    "input": "one PostgreSQL 17 EXPLAIN (ANALYZE, BUFFERS, VERBOSE, FORMAT JSON) top-level array containing exactly one object with Plan",
    "numericPolicy": {"type":"json-number","finite":true,"minimum":0,"minimumInclusive":true,"missing":"fail","negative":"fail","nonFinite":"fail","malformed":"fail"},
    "number": "A metric number must be a JSON number for which Number.isFinite(value) is true and value >= 0. Numeric strings, null, booleans, missing, negative, NaN and infinities are invalid.",
    "nodeTraversal": "Depth-first preorder over Plan and recursive Plans arrays. Workers entries are participant records and are never traversed as plan nodes.",
    "effectiveRows": "Actual Rows * Actual Loops, using finite non-negative JSON numbers from the plan node. Plan Rows is converted to loop-adjusted planned rows as Plan Rows * Actual Loops.",
    "parallelRows": "Plan-node Actual Rows and Actual Loops are leader-aggregated PostgreSQL evidence. Worker rows are not added, maximized or otherwise recounted for estimate, fan-out or nested-loop rules.",
    "parallelMemory": "A leader memory record and each object in Workers are distinct participant observations. Participant observations are never summed; the observation maximum is used. A worker record present for an executed qualifying node must contain the fields required by that node kind.",
    "workerExecutionRules": {
      "worker-actual-loops-positive": {
        "workersPath": ["Workers"],
        "recordIdentityPath": ["Worker Number"],
        "executionPath": ["Actual Loops"],
        "predicate": {"kind":"numeric-compare","operator":">","value":0},
        "numericPolicy": {"type":"json-number","finite":true,"minimum":0,"minimumInclusive":true,"missing":"fail","negative":"fail","nonFinite":"fail","malformed":"fail"},
        "absentCollection": "no-worker-observations",
        "emptyCollection": "no-worker-observations",
        "zeroExecution": "unexecuted-no-runtime-fields-no-observation-contribution-zero",
        "positiveExecution": "executed-runtime-fields-required",
        "invalidExecution": "fail-closed",
        "participantAggregation": "max",
        "leaderWorkerComposition": "independent-observations-max-never-sum"
      }
    },
    "multipleNodes": "Each metric produces zero or more observations per run. The per-run metric is the maximum observation, with an empty observation set equal to 0 only when the plan contains no qualifying node or edge.",
    "runs": {
      "program": {"track":"inner","measuredRunIndexes":["cold",1,2,3,4,5,6,7],"warmupsIncluded":false,"runAggregation":"all-pass","diagnosticValueAggregation":"max","comparison":"<=","equality":"pass","outerComposition":"independent-base-authority","mandatoryFailure":"suite-fail","diagnosticFailure":"record-not-suite-gate","missingEvidence":"fail"},
      "track": "inner only",
      "included": "the PostgreSQL-buffer-cold measured inner run and all seven measured warm inner runs",
      "excluded": "two unmeasured warm-ups and every outer run",
      "perRun": "Every included run is evaluated independently against the case profile.",
      "caseAggregation": "The case diagnostic value is the maximum of the eight per-run values. Any included run with an invalid observation, spill violation, or value above its threshold fails the case metric.",
      "comparison": "value <= threshold passes, including exact equality; value > threshold fails",
      "trackComposition": "These five metrics never use outer evidence. Existing outer obligations remain independently mandatory under the base authority.",
      "classification": "A mandatory case fails its suite on any metric failure. A diagnostic case records PASS or FAIL and complete evidence but does not become a mandatory suite gate. Missing diagnostic evidence is itself a diagnostic FAIL and must be reported."
    }
  },
  "metrics": {
    "maxEstimateRatio": {
      "program": {"kind":"node-symmetric-ratio-max","nodeTypes":"*","plannedPath":["Plan Rows"],"actualPath":["Actual Rows"],"loopsPath":["Actual Loops"],"scaleBothByLoops":true,"bothZero":1,"oneZero":"fail-infinity","parallelRows":"leader-only","nodeAggregation":"max"},
      "qualifyingNodes": "every traversed plan node",
      "fields": ["Plan Rows", "Actual Rows", "Actual Loops"],
      "formula": "planned = Plan Rows * Actual Loops; actual = Actual Rows * Actual Loops; ratio = zeroAwareSymmetricRatio(planned, actual)",
      "zeroAwareSymmetricRatio": "if planned == 0 and actual == 0 return 1; if exactly one is 0 return InfinityFail; otherwise return max(planned / actual, actual / planned)",
      "loops": "Both planned and actual rows are loop-adjusted before the ratio. Actual Loops > 1 is neither ignored nor applied twice.",
      "parallel": "leader-aggregated node fields only; ignore Workers row fields",
      "multipleNodes": "maximum ratio across all qualifying nodes",
      "missing": "any missing or invalid required field fails the run",
      "threshold": "maximum <= profile.maxEstimateRatio",
      "diagnostic": ["nodePath", "nodeType", "plannedEffectiveRows", "actualEffectiveRows", "ratio", "threshold", "verdict"]
    },
    "maxFanout": {
      "program": {"kind":"edge-directed-ratio-max","edges":"direct-Plans","childRelationshipPath":["Parent Relationship"],"excludedChildParentRelationships":["InitPlan","SubPlan"],"parentActualPath":["Actual Rows"],"parentLoopsPath":["Actual Loops"],"childActualPath":["Actual Rows"],"childLoopsPath":["Actual Loops"],"numerator":"child-effective-rows","denominator":"parent-effective-rows","bothZero":1,"positiveOverZero":"fail-infinity","parallelRows":"leader-only","edgeAggregation":"max"},
      "qualifyingEdges": "each direct parent Plans[i] edge except a child whose Parent Relationship is InitPlan or SubPlan",
      "fields": ["parent.Actual Rows", "parent.Actual Loops", "child.Actual Rows", "child.Actual Loops", "child.Parent Relationship when present"],
      "formula": "parentRows = parent.Actual Rows * parent.Actual Loops; childRows = child.Actual Rows * child.Actual Loops; fanout = directedZeroRatio(childRows, parentRows)",
      "directedZeroRatio": "if numerator == 0 and denominator == 0 return 1; if numerator > 0 and denominator == 0 return InfinityFail; otherwise return numerator / denominator",
      "basis": "loop-adjusted rows processed by a direct child divided by loop-adjusted rows emitted by its direct parent",
      "nestedPlans": "All ordinary nested Plans edges qualify recursively. InitPlan and SubPlan edges are excluded because they are not tuple-flow children of the parent output.",
      "parallel": "leader-aggregated parent and child node fields only; ignore Workers row fields",
      "multipleNodes": "maximum fan-out across qualifying edges",
      "missing": "any missing or invalid required parent/child field on a qualifying edge fails the run",
      "threshold": "maximum <= profile.maxFanout",
      "diagnostic": ["parentPath", "childPath", "parentNodeType", "childNodeType", "parentEffectiveRows", "childEffectiveRows", "fanout", "threshold", "verdict"]
    },
    "maxNestedLoopRows": {
      "program": {"kind":"nested-inner-effective-rows-max","nodeTypes":["Nested Loop"],"innerChildIndex":1,"actualPath":["Actual Rows"],"loopsPath":["Actual Loops"],"parallelRows":"leader-only","nodeAggregation":"max"},
      "qualifyingNodes": "Node Type exactly Nested Loop",
      "fields": ["Plans[1].Actual Rows", "Plans[1].Actual Loops"],
      "formula": "innerProcessedRows = Plans[1].Actual Rows * Plans[1].Actual Loops",
      "basis": "loop-adjusted rows processed by the direct inner child, Plans[1], of each Nested Loop",
      "childRule": "An executed Nested Loop must have exactly two or more Plans children and a valid direct inner child at index 1; otherwise fail closed.",
      "parallel": "leader-aggregated direct inner-child fields only; ignore Workers row fields",
      "multipleNodes": "maximum innerProcessedRows across Nested Loop nodes; do not sum nested nodes",
      "missing": "missing or invalid inner-child fields fail the run",
      "threshold": "maximum <= profile.maxNestedLoopRows",
      "diagnostic": ["nodePath", "innerPath", "innerEffectiveRows", "threshold", "verdict"]
    },
    "maxSortMemoryKb": {
      "program": {"kind":"sort-participant-memory-max","loopsPath":["Actual Loops"],"workerExecutionRule":"worker-actual-loops-positive","participants":{"leader":"node","aggregation":"max"},"sort":{"nodeTypes":["Sort"],"usedPath":["Sort Space Used"],"typePath":["Sort Space Type"],"memoryType":"Memory","diskType":"Disk"},"incremental":{"nodeTypes":["Incremental Sort"],"groups":[["Full-sort Groups"],["Pre-sorted Groups"]],"memoryPeakSuffix":["Sort Space Memory","Peak Sort Space Used"],"diskPeakSuffix":["Sort Space Disk","Peak Sort Space Used"]},"nodeAggregation":"max","unit":"kB","disk":"fail-spill"},
      "qualifyingNodes": ["Sort", "Incremental Sort"],
      "sortFields": ["Sort Space Used", "Sort Space Type"],
      "incrementalFields": ["Full-sort Groups.Sort Space Memory.Peak Sort Space Used", "Full-sort Groups.Sort Space Disk.Peak Sort Space Used", "Pre-sorted Groups.Sort Space Memory.Peak Sort Space Used", "Pre-sorted Groups.Sort Space Disk.Peak Sort Space Used"],
      "formula": "Sort memory observation is Sort Space Used when Sort Space Type == Memory. Incremental Sort memory observations are each present Peak Sort Space Used below Sort Space Memory. All values are already integer kB and are not converted.",
      "execution": "For a qualifying node with Actual Loops == 0, absent runtime sort fields yield observation 0. With Actual Loops > 0, required runtime fields for its node kind must be present and valid.",
      "spill": "A Sort participant with Sort Space Type == Disk, or any Incremental Sort participant with a positive Peak Sort Space Used below Sort Space Disk, is a separate unconditional spill failure under the base zero-spill rule. Disk kB is recorded but is not added to memory kB.",
      "parallel": "Apply the same node-kind field paths to the leader record and each Workers participant object. Take the maximum participant observation; never sum leader and workers.",
      "multipleNodes": "maximum memory kB across every node and participant",
      "missing": "an executed qualifying node or present worker missing its required runtime fields fails the run; an absent optional Incremental Sort group or absent disk group means no observation for that group",
      "threshold": "maximum <= profile.maxSortMemoryKb and no spill violation",
      "diagnostic": ["nodePath", "participant", "nodeType", "memoryKb", "diskKb", "spaceType", "threshold", "spill", "verdict"]
    },
    "maxHashMemoryKb": {
      "program": {"kind":"hash-participant-memory-max","qualifiers":[{"nodeType":"Hash","memoryPath":["Peak Memory Usage"],"batchesPath":["Hash Batches"],"diskPath":null},{"nodeType":"Aggregate","strategyPath":["Strategy"],"strategies":["Hashed","Mixed"],"memoryPath":["Peak Memory Usage"],"batchesPath":["HashAgg Batches"],"diskPath":["Disk Usage"]}],"loopsPath":["Actual Loops"],"workerExecutionRule":"worker-actual-loops-positive","participants":{"leader":"node","aggregation":"max"},"nodeAggregation":"max","unit":"kB","spill":{"batchesGreaterThan":1,"diskGreaterThan":0,"verdict":"fail-spill"}},
      "qualifyingNodes": ["Hash", "Aggregate where Strategy is Hashed or Mixed"],
      "hashFields": ["Peak Memory Usage", "Hash Batches"],
      "hashAggregateFields": ["Peak Memory Usage", "HashAgg Batches", "Disk Usage"],
      "formula": "Each qualifying leader or worker participant contributes Peak Memory Usage in kB. Values are already integer kB and are not converted. Hash Join is not a memory node; its Hash child is evaluated. Aggregate qualifies only when Strategy is Hashed or Mixed.",
      "execution": "For a qualifying node with Actual Loops == 0, absent runtime hash fields yield observation 0. With Actual Loops > 0, required runtime fields for its node kind must be present and valid.",
      "spill": "Hash Batches > 1, HashAgg Batches > 1, or Disk Usage > 0 is a separate unconditional spill failure under the base zero-spill rule. Disk usage is recorded but not added to memory kB.",
      "parallel": "Apply the same node-kind field paths to the leader record and each Workers participant object. Treat a parallel/shared hash participant report as one participant observation and take the maximum; never add or duplicate leader and worker values.",
      "multipleNodes": "maximum Peak Memory Usage across every node and participant",
      "missing": "an executed qualifying node or present worker missing required memory/batch/disk fields fails the run",
      "threshold": "maximum <= profile.maxHashMemoryKb and no spill violation",
      "diagnostic": ["nodePath", "participant", "nodeType", "strategy", "peakMemoryKb", "batches", "diskKb", "threshold", "spill", "verdict"]
    }
  },
