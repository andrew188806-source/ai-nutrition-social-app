# TastKind handoff inventory: placeholders only; live activation is OFF.
# Select only the section needed by each app/server. Do not publish this entire
# file as Expo/Vercel public configuration. Never commit real credentials.
# Current source authority and activation requirements: ENGINEER_HANDOFF.md.

# MOBILE / EXPO WEB PUBLIC: these values may be compiled into browser bundles.
# Explicit Development identity is required for live Consumer SDK composition.
# Placeholders below intentionally cannot pass the exact-project live gate.
EXPO_PUBLIC_TASTKIND_ENVIRONMENT=development
EXPO_PUBLIC_TASTKIND_CONSUMER_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_TASTKIND_CONSUMER_SUPABASE_PUBLISHABLE_KEY=YOUR_BROWSER_PUBLIC_PUBLISHABLE_KEY

# Auth/Profile: mock | supabase-disabled | supabase-live.
EXPO_PUBLIC_TASTKIND_CONSUMER_AUTH_SOURCE=mock
EXPO_PUBLIC_TASTKIND_CONSUMER_PROFILE_SOURCE=mock
EXPO_PUBLIC_TASTKIND_CONSUMER_SUPABASE_AUTH_ENABLED=false
EXPO_PUBLIC_TASTKIND_CONSUMER_SUPABASE_WRITES_ENABLED=false

# Photo pipeline: disabled | mock | supabase-live; live requires explicit
# Development + live Auth + the applicable write gates, never server secrets.
EXPO_PUBLIC_TASTKIND_CONSUMER_MEAL_PHOTO_UPLOAD_SOURCE=disabled
EXPO_PUBLIC_TASTKIND_CONSUMER_MEAL_PHOTO_ANALYSIS_SOURCE=disabled

# Meal reads: mock | supabase-disabled | supabase-live.
# Canonical writes have separate gates; a global write flag is not sufficient.
EXPO_PUBLIC_TASTKIND_CONSUMER_MEAL_RECORDS_SOURCE=mock
EXPO_PUBLIC_TASTKIND_CONSUMER_MEAL_RECORD_WRITES_ENABLED=false
EXPO_PUBLIC_TASTKIND_CONSUMER_MEAL_RECORD_LIVE_WRITE_OPT_IN=false
EXPO_PUBLIC_TASTKIND_CONSUMER_DAILY_NUTRITION_SOURCE=mock
EXPO_PUBLIC_TASTKIND_CONSUMER_DAILY_NUTRITION_LIVE_READ_OPT_IN=false
# Today Intake writes: disabled | mock | supabase.
EXPO_PUBLIC_TASTKIND_CONSUMER_DAILY_NUTRITION_WRITE_SOURCE=disabled

# Planned reads: disabled | mock | supabase | supabase_prepared (legacy).
# Planned writes: disabled | mock | supabase; prepared writes are rejected.
EXPO_PUBLIC_TASTKIND_CONSUMER_PLANNED_MEALS_SOURCE=disabled
EXPO_PUBLIC_TASTKIND_CONSUMER_PLANNED_MEALS_LIVE_READ_OPT_IN=false
EXPO_PUBLIC_TASTKIND_CONSUMER_PLANNED_MEALS_WRITE_SOURCE=disabled
# Correction: disabled | mock | supabase-prepared; finalization: disabled | mock | supabase.
EXPO_PUBLIC_TASTKIND_CONSUMER_MEAL_CORRECTION_SOURCE=disabled
EXPO_PUBLIC_TASTKIND_CONSUMER_MEAL_IDENTIFICATION_FINALIZATION_SOURCE=disabled

# Recommendation: disabled | mock | local-menu-demo | supabase.
# Its Allergy/Ingredient Avoidance authority is fail-closed, not bypassed here.
EXPO_PUBLIC_TASTKIND_CONSUMER_NEXT_MEAL_RECOMMENDATION_SOURCE=disabled
# Feedback, catalog, favorites, ratings: disabled | mock | supabase.
EXPO_PUBLIC_TASTKIND_CONSUMER_RECOMMENDATION_FEEDBACK_SOURCE=disabled
EXPO_PUBLIC_TASTKIND_CONSUMER_RESTAURANT_CATALOG_SOURCE=mock
EXPO_PUBLIC_TASTKIND_CONSUMER_FAVORITES_READ_SOURCE=disabled
EXPO_PUBLIC_TASTKIND_CONSUMER_FAVORITES_WRITE_SOURCE=disabled
EXPO_PUBLIC_TASTKIND_CONSUMER_RATINGS_READ_SOURCE=disabled
EXPO_PUBLIC_TASTKIND_CONSUMER_RATINGS_WRITE_SOURCE=disabled

# Social candidates: disabled | mock | supabase-live.
# Meal Buddy candidates: disabled | supabase-live (NO mock source).
EXPO_PUBLIC_TASTKIND_CONSUMER_SOCIAL_CANDIDATE_SOURCE=disabled
EXPO_PUBLIC_TASTKIND_CONSUMER_MEAL_BUDDY_CANDIDATE_SOURCE=disabled
EXPO_PUBLIC_ENABLE_DEMO_TOOLS=false

# Supported legacy Mobile aliases; canonical names above take precedence via ??.
# If deliberately using an alias, OMIT the canonical key; a blank canonical
# string still prevents alias fallback. Prefer the canonical names for new setup.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_TASTKIND_CONSUMER_MEAL_SOURCE=mock
EXPO_PUBLIC_TASTKIND_CONSUMER_SUPABASE_WRITES=false
# Legacy non-public environment alias; not a substitute for the explicit
# EXPO_PUBLIC_TASTKIND_ENVIRONMENT required by live client composition.
TASTKIND_ENVIRONMENT=development

# RESTAURANT WEB SERVER CONFIG: mock | disabled | supabase.
# Mock is refused under NODE_ENV=production; live mode is owner-scoped read-only
# for supported surfaces, not blanket Restaurant write/media/settings activation.
TASTKIND_RESTAURANT_DATA_SOURCE=mock
TASTKIND_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
TASTKIND_SUPABASE_PUBLISHABLE_KEY=YOUR_SERVER_PUBLIC_PUBLISHABLE_KEY

# Preserved legacy template entries, not read by the current active runtime.
# These do not enable an Admin backend, alternate transport, or live-to-mock fallback.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
TASTKIND_SUPABASE_READONLY_FALLBACK_TO_MOCK=true
TASTKIND_SUPABASE_TRANSPORT=rest

# SERVER-ONLY EDGE FUNCTIONS: provision privately, NEVER EXPO_PUBLIC/NEXT_PUBLIC.
# Do not forward these names/values to the browser or place secrets in app config.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
# Dedicated analysis persistence credential; no generic service-role fallback.
MEAL_PHOTO_ANALYSIS_ADMIN_KEY=
MEAL_PHOTO_ANALYSIS_ENABLED=false
MEAL_PHOTO_ANALYSIS_PROVIDER=disabled
OPENAI_API_KEY=
# Live openai mode requires an explicitly approved non-empty model; no secret here.
OPENAI_MEAL_ANALYSIS_MODEL=
OPENAI_MEAL_ANALYSIS_TIMEOUT_MS=30000

# SERVER-ONLY Social/Meal Buddy: sealed executor transport and independently
# provisioned opaque-reference keys. Blank = unavailable, not mock success.
SOCIAL_RUNTIME_EXECUTOR_SUPAVISOR_TRANSACTION_URL=
SOCIAL_CANDIDATE_REF_KEY_V1=
MEAL_BUDDY_CARD_REF_KEY_V1=
MEAL_BUDDY_RELATIONSHIP_REF_KEY_V1=
MEAL_BUDDY_CHAT_REF_KEY_V1=
# Dispatch secret authenticates operational calls; Expo token is server-only.
MEAL_BUDDY_PUSH_DISPATCH_SECRET=
EXPO_ACCESS_TOKEN=

# SERVER-ONLY geocoding dispatch: disabled | mock provider currently supported.
# No external live geocoder is implied; operational provider curation is follow-up.
RESTAURANT_GEOCODE_DISPATCH_SECRET=
RESTAURANT_GEOCODING_PROVIDER=disabled
RESTAURANT_GEOCODE_MAX_ATTEMPTS=3

# Preserved opt-in Phase 1C TEST HARNESS entries, not app activation.
# Leave disabled/blank. Never insert real personal identities or credentials here.
TASTKIND_CONSUMER_PHASE1C_LIVE_SMOKE=false
TASTKIND_CONSUMER_PHASE1C_SMOKE_EMAIL=
TASTKIND_CONSUMER_PHASE1C_SMOKE_PASSWORD=
TASTKIND_CONSUMER_PHASE1C_SMOKE_SIGN_UP_ENABLED=false
TASTKIND_CONSUMER_PHASE1C_SMOKE_SIGN_UP_EMAIL=
TASTKIND_CONSUMER_PHASE1C_SMOKE_SIGN_UP_PASSWORD=

# Intentionally not configured: framework NODE_ENV, other scripts-only harness
# keys, and ambient PG tuning variables (the executor rejects non-empty values).
# 56 active configuration keys + 10 retained legacy/test keys = 66 assignments.
