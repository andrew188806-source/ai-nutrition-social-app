{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@haocu/shared": ["packages/shared/src"],
      "@haocu/shared/*": ["packages/shared/src/*"],
      "@haocu/services": ["packages/services/src"],
      "@haocu/services/*": ["packages/services/src/*"],
      "@haocu/i18n/*": ["lib/i18n/*"]
    }
  }
}
